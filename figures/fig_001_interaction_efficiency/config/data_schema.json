  "data/processed/panel_a_tool_schema.csv": [
    {
      "column_name": "panel",
      "dtype": "string",
      "unit": "",
      "description": "建议的四联图面板标识",
      "allowed_values": "a|b|c|d",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "dataset",
      "dtype": "string",
      "unit": "",
      "description": "数据集；raw 保留作者拼写，processed 使用 aggregation.json 中的规范名称",
      "allowed_values": "EgoBench|EcomBench|ECom-Bench|TravelGym-v2|COMPASS|EgoLink2026",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "dataset_abbr",
      "dtype": "string",
      "unit": "",
      "description": "供绘图使用的数据集简称",
      "allowed_values": "EB|EC|TG|CP|EL",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "method",
      "dtype": "string",
      "unit": "",
      "description": "规范化后的推理框架名称，不代表 RoleLoop-PO 训练算法",
      "allowed_values": "ReAct|Summary|RoleLoop",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "condition",
      "dtype": "string",
      "unit": "",
      "description": "面板 d 内部工具视图条件；其他面板为 standard",
      "allowed_values": "standard|no_views|with_views",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "metric",
      "dtype": "string",
      "unit": "",
      "description": "当前面板度量名称",
      "allowed_values": "tool_description_tokens|logged_calls_per_task|tokens_per_task|estimated_tool_description_tokens_per_task",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "mean_value",
      "dtype": "number",
      "unit": "见 unit 字段",
      "description": "三个骨干级汇总值的等权算术均值；Decimal 28 位精度，未作绘图舍入",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "unit",
      "dtype": "string",
      "unit": "",
      "description": "mean_value 的基础单位；k 单位换算由绘图者执行",
      "allowed_values": "tokens|calls/task|tokens/task",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "n_models",
      "dtype": "integer",
      "unit": "backbones",
      "description": "参与均值的不同骨干数；不是任务数、seed 数或独立重复运行数",
      "allowed_values": "3",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "scope",
      "dtype": "string",
      "unit": "",
      "description": "统计对象、请求单位与观测/估算层次",
      "allowed_values": "见 docs/provenance.md",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "source_id",
      "dtype": "string",
      "unit": "",
      "description": "本图稳定来源标识，映射 data/sources.csv",
      "allowed_values": "author_table_1|author_table_2|author_table_3",
      "missing_value": "empty cell",
      "required": "true"
    }
  ],
