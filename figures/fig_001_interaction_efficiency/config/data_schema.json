{
  "data/raw/schema_calls.csv": [
    {
      "column_name": "source_id",
      "dtype": "string",
      "unit": "",
      "description": "本图稳定来源标识，映射 data/sources.csv",
      "allowed_values": "author_table_1|author_table_2|author_table_3",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "dataset",
      "dtype": "string",
      "unit": "",
      "description": "数据集；raw 保留作者拼写，processed 使用 aggregation.json 中的规范名称",
      "allowed_values": "EgoBench|EcomBench|ECom-Bench|TravelGym-v2|COMPASS|EgoLink2026",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "model",
      "dtype": "string",
      "unit": "",
      "description": "骨干模型；raw 工具视图表保留 Muse/Qwen/GPT 简称，processed 映射全称",
      "allowed_values": "见 config/aggregation.json model_aliases",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "react_tool_description_tokens_per_request",
      "dtype": "integer",
      "unit": "tokens/request",
      "description": "ReAct 单次请求的工具描述 token 估算",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "roleloop_tool_description_tokens_per_pe_pair",
      "dtype": "integer",
      "unit": "tokens/P+E pair",
      "description": "RoleLoop 一次 Planner+Executor 组合的工具描述 token 合计；不能当作单次调用",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "react_calls_per_task",
      "dtype": "number",
      "unit": "logged calls/task",
      "description": "作者给定 ReAct 每题平均日志调用次数；业务工具与模型请求的精确定义未提供",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "roleloop_pe_calls_per_task",
      "dtype": "number",
      "unit": "logged P/E calls/task",
      "description": "作者给定 RoleLoop 每题平均调用次数，仅计 Planner 与 Executor",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    }
  ],
  "data/raw/tool_views.csv": [
    {
      "column_name": "source_id",
      "dtype": "string",
      "unit": "",
      "description": "本图稳定来源标识，映射 data/sources.csv",
      "allowed_values": "author_table_1|author_table_2|author_table_3",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "dataset",
      "dtype": "string",
      "unit": "",
      "description": "数据集；raw 保留作者拼写，processed 使用 aggregation.json 中的规范名称",
      "allowed_values": "EgoBench|EcomBench|ECom-Bench|TravelGym-v2|COMPASS|EgoLink2026",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "model",
      "dtype": "string",
      "unit": "",
      "description": "骨干模型；raw 工具视图表保留 Muse/Qwen/GPT 简称，processed 映射全称",
      "allowed_values": "见 config/aggregation.json model_aliases",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "full_library_tool_description_tokens_per_request",
      "dtype": "integer",
      "unit": "tokens/request",
      "description": "工具视图重建统计中的完整工具库单次描述；不等同于 ReAct 原生工具接口",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "viewed_tool_description_tokens_per_pe_pair",
      "dtype": "integer",
      "unit": "tokens/P+E pair",
      "description": "有视图条件下 P+E 两类角色的工具描述合计",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "reported_tool_description_difference_tokens",
      "dtype": "integer",
      "unit": "tokens",
      "description": "作者原表的完整库减 P+E 描述差值，保留负值",
      "allowed_values": "signed integer",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "no_view_estimated_tool_description_tokens_per_task",
      "dtype": "integer",
      "unit": "tokens/task",
      "description": "固定轨迹重建的无视图每题累计工具描述开销；原口径包含 Reporter",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "with_view_estimated_tool_description_tokens_per_task",
      "dtype": "integer",
      "unit": "tokens/task",
      "description": "固定轨迹重建的有视图每题累计工具描述开销；原口径包含 Reporter",
      "allowed_values": ">=0",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "reported_saving_tokens_per_task",
      "dtype": "integer",
      "unit": "tokens/task",
      "description": "原表每题节省估算；保留原值和取整差异",
      "allowed_values": "signed integer",
      "missing_value": "empty cell",
      "required": "true"
    },
    {
      "column_name": "reported_saving_pct",
      "dtype": "number",
      "unit": "percent 0-100 scale; signed",
      "description": "作者给定节省比例百分数；TravelGym 的原负号保留且标记冲突",
      "allowed_values": "signed percent",
      "missing_value": "empty cell",
      "required": "true"
    }
  ],
